# Deep research: the report and ledger ARE committed, because GUIDE.txt cites
# them and this is a public repo. Only raw scratch notes are ignored.
.deep-research/notes/*

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# Training / inference outputs
runs/
outputs/
checkpoints/
wandb/
*.log
!requirements*.txt

