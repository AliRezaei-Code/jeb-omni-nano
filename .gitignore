# Deep research: the report, ledger and notes ARE committed. GUIDE.txt cites the
# report and sources-ledger.md links to notes/, so ignoring them would leave two
# dangling references in a public repo. Weights, runs and caches stay ignored.
#
# Revert with:
#   git rm -r --cached .deep-research
#   echo '.deep-research/' >> .gitignore

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# Training / inference outputs. Checkpoints, weights and logs stay ignored, but
# the RESULT json is the evidence: it carries the `_per_row` per-question
# outcomes that the reported risk-coverage curve, coverage-at-5% figures and
# Clopper-Pearson intervals are computed from. Without it a reader cannot
# verify any headline number in the report.
runs/*
!runs/*/
!runs/**/*.json
outputs/
checkpoints/
wandb/
*.log
!requirements*.txt

# Model artifacts — never commit weights
*.safetensors
*.gguf
*.bin
*.pt
*.onnx
head.pt

# Data caches
.cache/
data/raw/
data/processed/

# OS / editors
.DS_Store
Thumbs.db
.idea/
.vscode/
